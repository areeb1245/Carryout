# Copy to .env for running on this computer, or set these on the host (Render asks for them; see render.yaml).
# Never commit the real values.

# Staff sign-in. Without a STAFF_CODE the staff screens are open to this computer only.
STAFF_CODE=
JWT_SECRET=

# SAM 3.1 endpoint on Modal (modal_app/sam_checkout.py)
SAM_URL=
SAM_API_KEY=

# The vision language model behind the second looks and the check before charging
LLM_URL=
LLM_MODAL_KEY=
LLM_MODAL_SECRET=

# PayPal sandbox only: the app refuses anything else
PAYPAL_ENV=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=

# Invoice email through Resend
RESEND_API_KEY=
RESEND_FROM=

# Face embeddings in Postgres with pgvector. FACE_TABLE gives each copy of the app its own table.
DATABASE_URL=
FACE_TABLE=checkout_faces

# Where the database, catalogues and clips live (default: the project's data/ and shops/)
DATA_DIR=

# Optional
DEMO_EMAIL=
SAM_MAX_PROMPTS=8
SAM_MAX_FPS=3
